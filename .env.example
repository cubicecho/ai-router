# Signs sessions. Required in production; generate one with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# The Postgres server. Required: boot waits for it and migrates it. `npm run db:up` starts this one.
DATABASE_URL=postgres://router:router@localhost:5440/router

# Sign in through an OpenID Connect provider (heautou, Keycloak, Authentik, …). The easier way is
# to leave these unset and paste a setup URL from the provider into the sign-in page: the router
# then registers itself. Set here, the provider wins and cannot be changed from the UI. Register
# the redirect URI the server prints at boot: <SERVER_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://id.example.com/oidc
# OIDC_CLIENT_ID=ai-router
# OIDC_CLIENT_SECRET=
# client_secret_basic (default) or client_secret_post; the provider must agree.
# OIDC_CLIENT_AUTH=client_secret_basic
# What the sign-in page's button calls it. Default: SSO
# OIDC_NAME=heautou

# On a private network only: whoever opens the UI is signed in as the admin, with no provider.
# Apps still need a workspace key. Refused at boot when APP_URL is a public address, unless
# I_KNOW_SECURE_LOCAL_NET_IS_PUBLIC=true. Default false.
# SECURE_LOCAL_NET=false

# Where people open the UI. Default http://localhost:PORT. In development, Vite's address.
# APP_URL=http://localhost:3000

# Where a browser reaches this server, for the OIDC sign-in's start and callback. Defaults to
# APP_URL in production, where they are the same, and to http://localhost:PORT in development.
# SERVER_URL=http://localhost:3001

# The port to listen on. Default 3000. In development the UI's Vite server takes 3000, so the
# server runs on 3001.
# PORT=3001

# How long boot waits for Postgres, in ms. Default 60000.
# DB_CONNECT_TIMEOUT_MS=60000

# Proxies in front of this server that may set X-Forwarded-For. Default false (none). "1" for one
# reverse proxy (Caddy, Traefik, nginx); or "loopback", "uniquelocal", or a list of addresses.
# Sign-in rate limits key on the client address, so get this right behind a proxy. Never "true"
# when the port is reachable from the internet: any client could then choose its own address.
# TRUST_PROXY=1

# Where the helper that starts MCP servers as their own users is. The image installs it at the
# default, /usr/local/bin/run-as-child. Without it, development runs servers as the router's own
# user with a warning, and production refuses to start them.
# RUN_AS_CHILD=/usr/local/bin/run-as-child
