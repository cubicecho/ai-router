{
  "name": "ai-router",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "Agents, models and tools for every app on a network, through one address and one key per app.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run codegen && vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "codegen": "node server/graphql/write-schema.ts && graphql-codegen",
    "check": "npm run codegen && npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PORT=3001 APP_URL=http://localhost:3000 node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "overrides": {
    "graphql": "$graphql",
    "drizzle-orm": "$drizzle-orm"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.25",
    "@casl/ability": "^7.1.3",
    "@cubicecho/agent-core": "^6.0.1",
    "@cubicecho/graphql-better-auth": "^1.1.0",
    "@cubicecho/graphql-mcp": "^3.1.0",
    "@escape.tech/graphql-armor-max-aliases": "^2.6.2",
    "@escape.tech/graphql-armor-max-depth": "^2.4.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@vantreeseba/drizzle-graphql": "^19.0.0",
    "@vantreeseba/graphql-casl": "^1.11.0",
    "better-auth": "^1.7.25",
    "cmdk": "^1.1.1",
    "drizzle-orm": "1.0.0-rc.5",
    "express": "^5.3.0",
    "graphql": "16.13.2",
    "graphql-middleware": "^6.1.35",
    "graphql-query-complexity": "^2.0.0",
    "graphql-scalars": "^2.0.1",
    "graphql-yoga": "^5.24.6",
    "pg": "^8.23.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/geist": "^5.3.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "1.0.0-rc.5",
    "jose": "^6.2.17",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
